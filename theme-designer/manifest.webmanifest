{
  "id": "./index.html",
  "name": "Theme CAD — Point-CAD Theme Designer",
  "short_name": "Theme CAD",
  "description": "Constraint-solved perceptual color schemes and CSS token publisher powered by Point-CAD.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0a0d14",
  "theme_color": "#0a0d14",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/vnd.themecad": [".tcad", ".themecad"],
        "application/vnd.pointcad": [".pcad", ".pointcad"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+themecad",
      "url": "./index.html?src=%s"
    },
    {
      "protocol": "web+pointcad",
      "url": "./index.html?src=%s"
    }
  ]
}